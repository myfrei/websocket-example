# Copy to ".env" to override the built-in demo defaults (compose works without it).

# Shared JWT signing secret (HS256). MUST be at least 32 characters.
JWT_SECRET=change-me-super-secret-bank-demo-key-which-is-quite-long-0123456789

# Shared secret guarding account-service /internal/** endpoints (service-to-service).
INTERNAL_API_KEY=internal-demo-key-please-change
